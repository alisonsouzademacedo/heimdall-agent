# ENV_EXEMPLO_SEM_SEGREDO: modelo com valores de MENTIRA. Copie para infra/compose/.env (ignorado pelo git) e troque os valores.
# Nunca coloque chaves reais neste arquivo de exemplo.
POSTGRES_PASSWORD=troque-esta-senha-exemplo
API_SERVER_KEY=troque-esta-chave-exemplo-0123456789abcdef
# none = sem LLM (so trechos e busca). Troque para chatgpt DEPOIS do login (docs/plano/runbooks/07-logins.md).
HINDSIGHT_API_LLM_PROVIDER=none
# Pasta de dados reais (fora do git). O padrao e ../../data (a pasta data/ do projeto).
# HEIMDALL_DATA=../../data
# Krayin (CRM). Gere valores novos: openssl rand -hex 24 (senhas) e "base64:" + openssl rand -base64 32 (APP_KEY).
KRAYIN_DB_ROOT_PASSWORD=troque-esta-senha-exemplo-root
KRAYIN_DB_PASSWORD=troque-esta-senha-exemplo-krayin
KRAYIN_APP_KEY=base64:troque-esta-chave-exemplo-0123456789abcdefghijk=
# Administrador do Krayin criado por infra/krayin/instalar.sh (nunca a senha padrao admin123).
KRAYIN_ADMIN_EMAIL=dono@heimdall.local
KRAYIN_ADMIN_PASSWORD=troque-esta-senha-exemplo-admin
